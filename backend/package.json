{
  "name": "meu-player-backend",
  "version": "1.0.0",
  "description": "API e banco de dados do Meu Player (Node.js + SQLite nativo, sem dependências)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
